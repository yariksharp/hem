# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Variables are added here by later stories (Vercel, Supabase, AI).
NEXT_PUBLIC_APP_ENV=

# Supabase: Dashboard → Project Settings → API. Public values, safe in the browser (RLS protects the data).
# Never add the service-role key here with a NEXT_PUBLIC_ name.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
